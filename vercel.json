{
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/blogs.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/blogs.js" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ],
  "ignoreCommand": "echo 'Ignoring non-function files'"
}
