{
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/blogs", "methods": ["GET"], "dest": "/api/blogs/get.js" },
    { "src": "/api/blogs", "methods": ["POST"], "dest": "/api/blogs/post.js" },
     {
      "src": "^(?!/api/).*",
      "dest": "/frontend/dist/index.html"
    }
  ]
}
